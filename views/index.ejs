<div class="row flex-lg-row-reverse align-items-center g=5 py-4 mb-4">
    <div class="col-12 col-lg-6">
        <img src="/img/publish-recipe.jpg" width="687" height="510" class="d-block mx-lg-auto img-fluid" loading="lazy">
    </div>

    <div class="col-12 col-lg-6">
        <h1 class="display-5 fw-bold mb-3">Huge selection of delicious recipe ideas</h1>
        <p class="lead">
            Explore our variety of recepies.
        </p>
        <div class="d-grid gap-2 d-md-flex justify-content-md-start">
            <a href="/explore-latest" class="btn btn-primary btn-dark btn-lg px-4 me-md-2">Explore Latest</a>
            <a href="/random-recipe" class="btn btn-outline-secondary btn-lg px-4 me-md-2">Random Recipe</a>
        </div>
    </div>
</div>

<!-- Cuisines -->
<section>
    <div class="row row-cols-2 row-cols-lg-6 g-2 g-lg-3 py-4">
        <% if(cuisines !='' ) { %>
            <% cuisines.forEach(function(category, index) { %>
                <a href="/cuisine/<%- category.name %>" class="col text-center category__link">
                    <div class="category__img shadow">
                        <img src="img/<%- category.image %>" alt="Cuisine Image" loading="lazy">
                    </div>
                    <div class="pt-1"><%- category.name %></div>
                </a>
                <% }) %>
                    <% } %>
                        <!--View All-->
                        <a href="/cuisines" class="col text-center category__link">
                            <div class="category__img shadow">
                                <img src="img/view-all.jpg" alt="View All Cuisines" loading="lazy">
                            </div>
                            <div class="pt-1">View All</div>
                        </a>
    </div>
</section>


<!-- Latest -->
<section class="pd-4 pt-4">

    <div class="d-flex mb-2 align-items-center">
        <h2>Latest Recipes</h2>
        <a href="/explore-latest" class="ms-auto">View More</a>
    </div>
    <div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3">
        <% if(food != '') { %>
            <% food.latest.forEach(function(recipe, index){ %>
                <a href="/recipe/<%= recipe._id %>" class="col text-center category__link">
                    <div class="category__img category__img--large shadow">
                        <img src="/uploads/<%= recipe.image %>" alt="Recipe Image" loading="lazy">
                    </div>
                    <div class="pt-1"><%= recipe.name %></div>
                </a>
            <% }) %>
        <% } else { %>
            <p>No Items Found.</p>
        <% } %>
    </div>

</section>

