<h1 class="pb-4">Random Recipe</h1>

<div>
    <% if(recipe != '') { %>

            <div class="row">
                <div class="col-12 col-md-4">
                    <img src="/uploads/<%- recipe.image %>" alt="Recipe Image" class="img-fluid sticky-top" style="top:20px;" loading="lazy">
                </div>
                <div class ="col-12 col-md-8">
                    <div class="row">
                        <div class="col-12"><h1><%- recipe.name %></h1></div>
                        <div class="col-12 mb-4"><i class="bi bi-tag"></i> <%- recipe.category %></div>
                        <div class="col-12">
                            <%- recipe.description %>
                        </div>
                    </div>
                    <div class="row pt-4">
                        <div class="col-12">
                            <h4>Ingredients</h4>
                            <ul class="list-group list-group-flush">
                                <% recipe.ingredients.forEach(function(ingredients, index){ %>
                                    <li class="list-group-item"><%= ingredients %></li>
                                <% }) %>
                            </ul>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12" style="white-space: pre-line;">
                            <h4> Cooking Instructions</h4>
                            <%- recipe.instructions %>
                        </div>
                    </div>
                </div>
            </div>

    <% } else { %>
      <p>No items found.</p>
    <% } %> 
</div>



